import TS.Induction

/-!
# The Tarski–Seidenberg theorem for semialgebraic subsets of `ℝ^ι`

`IsSemialgebraic s` for `s ⊆ (ι → ℝ)`: the Boolean algebra generated by the positivity sets of
real polynomial functions.  Main results:

* `Semialg.exists_cells`: every semialgebraic set is the set of points whose sign vector on a
  finite set of polynomials lies in a prescribed set of sign vectors;
* `IsSemialgebraic.image_proj`: the projection `(Option ι → ℝ) → (ι → ℝ)` forgetting the
  coordinate `none` maps semialgebraic sets to semialgebraic sets (Tarski–Seidenberg);
* `IsSemialgebraic.reindex`: invariance under renaming of coordinates;
* `IsSemialgebraic.image_sum_inl`: the projection `(α ⊕ β → ℝ) → (α → ℝ)` forgetting finitely
  many coordinates maps semialgebraic sets to semialgebraic sets.
-/

namespace TS

open Polynomial Set
open scoped Classical

/-! ### Cells -/

section Cells

variable {A : Type*} [CommRing A] {X : Type*} (ev : X → A →+* ℝ)

/-- The sign vector of `x` on the finite set `L`. -/
noncomputable def cellOf (L : Finset A) (x : X) : L → SignType := fun a => SignType.sign (ev x a.1)

/-- **Every semialgebraic set is a union of sign cells**: it is the set of `x` whose sign vector on
some finite `L ⊆ A` lies in a set `E` of sign vectors. -/
theorem Semialg.exists_cells {s : Set X} (hs : Semialg (Rev ev) s) :
    ∃ (L : Finset A) (E : Set (L → SignType)), s = {x | cellOf ev L x ∈ E} := by
  induction hs with
  | pos hr =>
    obtain ⟨a, rfl⟩ := hr
    refine ⟨{a}, {ε | ε ⟨a, Finset.mem_singleton_self a⟩ = 1}, ?_⟩
    ext x
    simp only [Set.mem_ofPred_eq, cellOf, sign_eq_one_iff]
    rfl
  | univ => exact ⟨∅, Set.univ, by ext x; simp⟩
  | compl _ ih =>
    obtain ⟨L, E, rfl⟩ := ih
    exact ⟨L, Eᶜ, by ext x; simp⟩
  | inter _ _ ih₁ ih₂ =>
    obtain ⟨L₁, E₁, rfl⟩ := ih₁
    obtain ⟨L₂, E₂, rfl⟩ := ih₂
    refine ⟨L₁ ∪ L₂, {ε | (fun a : L₁ => ε ⟨a.1, Finset.mem_union_left _ a.2⟩) ∈ E₁ ∧
      (fun a : L₂ => ε ⟨a.1, Finset.mem_union_right _ a.2⟩) ∈ E₂}, ?_⟩
    ext x
    simp only [Set.mem_inter_iff, Set.mem_ofPred_eq, cellOf]
    exact Iff.rfl

end Cells

/-! ### Polynomial functions on `ℝ^ι` -/

/-- Evaluation of multivariate polynomials. -/
def mvEv (ι : Type*) : (ι → ℝ) → MvPolynomial ι ℝ →+* ℝ := fun x => MvPolynomial.eval x

/-- Semialgebraic subsets of `ℝ^ι`. -/
def IsSemialgebraic {ι : Type*} (s : Set (ι → ℝ)) : Prop := Semialg (Rev (mvEv ι)) s

variable {ι : Type*}

theorem isSemialgebraic_pos (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | 0 < MvPolynomial.eval x p} :=
  Semialg.pos (mem_Rev (mvEv ι) p)

theorem isSemialgebraic_zero (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | MvPolynomial.eval x p = 0} :=
  semialg_zero (mvEv ι) p

theorem isSemialgebraic_nonneg (p : MvPolynomial ι ℝ) :
    IsSemialgebraic {x : ι → ℝ | 0 ≤ MvPolynomial.eval x p} :=
  Semialg.nonneg (mem_Rev (mvEv ι) p)

theorem IsSemialgebraic.inter {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s ∩ t) := Semialg.inter hs ht

theorem IsSemialgebraic.union {s t : Set (ι → ℝ)} (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) :
    IsSemialgebraic (s ∪ t) := Semialg.union hs ht

theorem IsSemialgebraic.compl {s : Set (ι → ℝ)} (hs : IsSemialgebraic s) : IsSemialgebraic sᶜ :=
  Semialg.compl hs

theorem IsSemialgebraic.iInter {κ : Type*} [Fintype κ] {t : κ → Set (ι → ℝ)}
    (ht : ∀ i, IsSemialgebraic (t i)) : IsSemialgebraic (⋂ i, t i) := Semialg.iInter ht

theorem IsSemialgebraic.iUnion {κ : Type*} [Fintype κ] {t : κ → Set (ι → ℝ)}
    (ht : ∀ i, IsSemialgebraic (t i)) : IsSemialgebraic (⋃ i, t i) := Semialg.iUnion ht

theorem isSemialgebraic_univ : IsSemialgebraic (Set.univ : Set (ι → ℝ)) := Semialg.univ

/-- Evaluating a polynomial in the variables `Option ι` at `(t, x)` is evaluating, at `t`, the
polynomial in one variable with coefficients evaluated at `x`. -/
theorem eval_elim (x : ι → ℝ) (t : ℝ) (p : MvPolynomial (Option ι) ℝ) :
    MvPolynomial.eval (fun o : Option ι => o.elim t x) p =
      Polynomial.eval t (((MvPolynomial.optionEquivLeft ℝ ι) p).map (MvPolynomial.eval x)) := by
  have : MvPolynomial.eval (fun o : Option ι => o.elim t x) =
      (Polynomial.evalRingHom t).comp ((Polynomial.mapRingHom (MvPolynomial.eval x)).comp
        (MvPolynomial.optionEquivLeft ℝ ι : MvPolynomial (Option ι) ℝ →+* (MvPolynomial ι ℝ)[X])) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp
    · intro o
      cases o <;> simp
  exact RingHom.congr_fun this p

/-- The projection forgetting the coordinate `none`. -/
def projNone : (Option ι → ℝ) → (ι → ℝ) := fun y i => y (some i)

theorem projNone_elim (x : ι → ℝ) (t : ℝ) : projNone (fun o : Option ι => o.elim t x) = x := rfl

theorem elim_projNone (y : Option ι → ℝ) : (fun o : Option ι => o.elim (y none) (projNone y)) = y := by
  funext o
  cases o <;> rfl

/-- **Tarski–Seidenberg**: the projection of a semialgebraic subset of `ℝ^(Option ι)` forgetting
one coordinate is semialgebraic. -/
theorem IsSemialgebraic.image_proj {s : Set (Option ι → ℝ)} (hs : IsSemialgebraic s) :
    IsSemialgebraic (projNone '' s) := by
  obtain ⟨L, E, rfl⟩ := Semialg.exists_cells (mvEv (Option ι)) hs
  -- the polynomials of `L` as polynomials in one variable over `MvPolynomial ι ℝ`
  set φ := MvPolynomial.optionEquivLeft ℝ ι with hφ
  set F₀ : Finset (MvPolynomial ι ℝ)[X] := L.image φ with hF₀
  -- the image is a finite union over the sign vectors in `E`
  have hdecomp : projNone '' {y | cellOf (mvEv (Option ι)) L y ∈ E} =
      ⋃ ε : L → SignType, {x | ε ∈ E ∧
        ∃ t : ℝ, ∀ a : L, SignType.sign (MvPolynomial.eval (fun o : Option ι => o.elim t x) a.1) = ε a} := by
    ext x
    simp only [Set.mem_image, Set.mem_ofPred_eq, Set.mem_iUnion]
    constructor
    · rintro ⟨y, hy, rfl⟩
      refine ⟨cellOf (mvEv (Option ι)) L y, hy, y none, fun a => ?_⟩
      rw [elim_projNone]
      rfl
    · rintro ⟨ε, hε, t, ht⟩
      refine ⟨fun o => o.elim t x, ?_, projNone_elim x t⟩
      have : cellOf (mvEv (Option ι)) L (fun o => o.elim t x) = ε := funext fun a => ht a
      rw [this]
      exact hε
  rw [hdecomp]
  refine Semialg.iUnion fun ε => ?_
  -- the sign condition in the relative form
  let ε' : (MvPolynomial ι ℝ)[X] → SignType := fun g =>
    if h : φ.symm g ∈ L then ε ⟨φ.symm g, h⟩ else 0
  have hcond : ∀ x : ι → ℝ, ∀ t : ℝ,
      (∀ a : L, SignType.sign (MvPolynomial.eval (fun o : Option ι => o.elim t x) a.1) = ε a) ↔
      ∀ g ∈ F₀, SignType.sign (Polynomial.eval t (g.map (mvEv ι x))) = ε' g := by
    intro x t
    constructor
    · intro h g hg
      rw [hF₀, Finset.mem_image] at hg
      obtain ⟨a, ha, rfl⟩ := hg
      have h1 : ε' (φ a) = ε ⟨a, ha⟩ := by
        simp only [ε', AlgEquiv.symm_apply_apply, ha, ↓reduceDIte]
      rw [h1, ← h ⟨a, ha⟩, eval_elim]
      rfl
    · intro h a
      have hg : φ a.1 ∈ F₀ := by
        rw [hF₀, Finset.mem_image]
        exact ⟨a.1, a.2, rfl⟩
      have h1 : ε' (φ a.1) = ε a := by
        simp only [ε', AlgEquiv.symm_apply_apply, a.2, ↓reduceDIte]
      have := h _ hg
      rw [h1] at this
      rw [eval_elim]
      exact this
  have : {x : ι → ℝ | ε ∈ E ∧
      ∃ t : ℝ, ∀ a : L, SignType.sign (MvPolynomial.eval (fun o : Option ι => o.elim t x) a.1) = ε a} =
      {_x : ι → ℝ | ε ∈ E} ∩
        {x | ∃ t : ℝ, ∀ g ∈ F₀, SignType.sign (Polynomial.eval t (g.map (mvEv ι x))) = ε' g} := by
    ext x
    simp only [Set.mem_ofPred_eq, Set.mem_inter_iff]
    constructor
    · rintro ⟨hε, t, ht⟩
      exact ⟨hε, t, (hcond x t).mp ht⟩
    · rintro ⟨hε, t, ht⟩
      exact ⟨hε, t, (hcond x t).mpr ht⟩
  rw [this]
  exact (semialg_const _ _).inter (semialg_exists_sign (mvEv ι) F₀ ε')

/-! ### Renaming coordinates and eliminating finitely many -/

/-- Renaming the coordinates by an equivalence preserves semialgebraicity. -/
theorem IsSemialgebraic.reindex {κ κ' : Type*} (e : κ ≃ κ') {s : Set (κ → ℝ)} (hs : IsSemialgebraic s) :
    IsSemialgebraic ((fun y : κ → ℝ => fun j => y (e.symm j)) '' s) := by
  have heq : (fun y : κ → ℝ => fun j => y (e.symm j)) '' s = (fun z : κ' → ℝ => fun i => z (e i)) ⁻¹' s := by
    ext z
    constructor
    · rintro ⟨y, hy, rfl⟩
      simpa using hy
    · intro hz
      exact ⟨fun i => z (e i), hz, by funext j; simp⟩
  rw [heq]
  refine Semialg.preimage (R := Rev (mvEv κ)) _ (fun r hr => ?_) hs
  obtain ⟨p, rfl⟩ := hr
  refine ⟨MvPolynomial.rename e p, ?_⟩
  funext z
  simp only [evRing, RingHom.pi_apply, mvEv, MvPolynomial.eval_rename]
  rfl

/-- `α ⊕ Option γ ≃ Option (α ⊕ γ)`. -/
def sumOptionEquiv (α γ : Type*) : α ⊕ Option γ ≃ Option (α ⊕ γ) where
  toFun := fun x => match x with
    | Sum.inl a => some (Sum.inl a)
    | Sum.inr none => none
    | Sum.inr (some g) => some (Sum.inr g)
  invFun := fun o => match o with
    | none => Sum.inr none
    | some (Sum.inl a) => Sum.inl a
    | some (Sum.inr g) => Sum.inr (some g)
  left_inv := by rintro (a | _ | g) <;> rfl
  right_inv := by rintro (_ | a | g) <;> rfl

/-- The projection `(α ⊕ β → ℝ) → (α → ℝ)`. -/
def projInl (α β : Type*) : (α ⊕ β → ℝ) → (α → ℝ) := fun y a => y (Sum.inl a)

theorem IsSemialgebraic.image_projInl_fin (α : Type*) :
    ∀ (n : ℕ) (s : Set (α ⊕ Fin n → ℝ)), IsSemialgebraic s → IsSemialgebraic (projInl α (Fin n) '' s) := by
  intro n
  induction n with
  | zero =>
    intro s hs
    have := hs.reindex (Equiv.sumEmpty α (Fin 0))
    convert this using 2
    all_goals rfl
  | succ n ih =>
    intro s hs
    let e : α ⊕ Fin (n + 1) ≃ Option (α ⊕ Fin n) :=
      (Equiv.sumCongr (Equiv.refl α) (finSuccEquiv n)).trans (sumOptionEquiv α (Fin n))
    have h1 := hs.reindex e
    have h2 := h1.image_proj
    have h3 := ih _ h2
    convert h3 using 1
    rw [Set.image_image, Set.image_image]
    refine Set.image_congr fun y _ => ?_
    funext a
    rfl

/-- **Elimination of finitely many coordinates**: the projection of a semialgebraic subset of
`ℝ^(α ⊕ β)` onto `ℝ^α` is semialgebraic for every finite `β`. -/
theorem IsSemialgebraic.image_projInl {α β : Type*} [Fintype β] {s : Set (α ⊕ β → ℝ)}
    (hs : IsSemialgebraic s) : IsSemialgebraic (projInl α β '' s) := by
  let e : α ⊕ β ≃ α ⊕ Fin (Fintype.card β) := Equiv.sumCongr (Equiv.refl α) (Fintype.equivFin β)
  have h1 := hs.reindex e
  have h2 := IsSemialgebraic.image_projInl_fin α _ _ h1
  convert h2 using 1
  rw [Set.image_image]
  refine Set.image_congr fun y _ => ?_
  funext a
  rfl

end TS
