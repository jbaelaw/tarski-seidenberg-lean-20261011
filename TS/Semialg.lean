import Mathlib

/-!
# Relative semialgebraic sets

`Semialg R s` says that `s ⊆ X` belongs to the Boolean algebra of subsets of `X` generated by
the positivity sets `{x | 0 < r x}` of the functions `r` in a subring `R` of `X → ℝ`.  With
`R` the ring of polynomial functions on `X = ℝ^n` these are the semialgebraic sets; the relative
formulation is what the parametric (Hörmander) induction of the Tarski–Seidenberg theorem uses.
-/

namespace TS

variable {X : Type*}

/-- The Boolean algebra generated by the positivity sets of the functions in `R`. -/
inductive Semialg (R : Subring (X → ℝ)) : Set X → Prop
  | pos {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | 0 < r x}
  | univ : Semialg R Set.univ
  | compl {s : Set X} : Semialg R s → Semialg R sᶜ
  | inter {s t : Set X} : Semialg R s → Semialg R t → Semialg R (s ∩ t)

namespace Semialg

variable {R : Subring (X → ℝ)}

theorem of_eq {s t : Set X} (hs : Semialg R s) (h : s = t) : Semialg R t := h ▸ hs

theorem empty : Semialg R (∅ : Set X) := by
  have := (univ : Semialg R Set.univ).compl
  rwa [Set.compl_univ] at this

theorem union {s t : Set X} (hs : Semialg R s) (ht : Semialg R t) : Semialg R (s ∪ t) := by
  have := (hs.compl.inter ht.compl).compl
  rwa [Set.compl_inter, compl_compl, compl_compl] at this

theorem diff {s t : Set X} (hs : Semialg R s) (ht : Semialg R t) : Semialg R (s \ t) :=
  hs.inter ht.compl

theorem neg {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | r x < 0} := by
  have := pos (R := R) (R.neg_mem hr)
  refine this.of_eq ?_
  ext x
  simp

theorem nonneg {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | 0 ≤ r x} := by
  have := (neg hr).compl
  refine this.of_eq ?_
  ext x
  simp

theorem nonpos {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | r x ≤ 0} := by
  have := (pos hr).compl
  refine this.of_eq ?_
  ext x
  simp

theorem zero {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | r x = 0} := by
  have := (nonneg hr).inter (nonpos hr)
  refine this.of_eq ?_
  ext x
  simp only [Set.mem_inter_iff, Set.mem_ofPred_eq]
  exact ⟨fun h => le_antisymm h.2 h.1, fun h => ⟨h.ge, h.le⟩⟩

theorem ne_zero {r : X → ℝ} (hr : r ∈ R) : Semialg R {x | r x ≠ 0} := by
  have := (zero hr).compl
  refine this.of_eq ?_
  ext x
  simp

theorem sign_eq {r : X → ℝ} (hr : r ∈ R) (σ : SignType) :
    Semialg R {x | SignType.sign (r x) = σ} := by
  cases σ
  · exact (zero hr).of_eq (by ext x; simp [sign_eq_zero_iff])
  · exact (neg hr).of_eq (by ext x; simp [sign_eq_neg_one_iff])
  · exact (pos hr).of_eq (by ext x; simp [sign_eq_one_iff])

theorem iInter_finset {ι : Type*} (s : Finset ι) {t : ι → Set X}
    (ht : ∀ i ∈ s, Semialg R (t i)) : Semialg R (⋂ i ∈ s, t i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact univ.of_eq (by simp)
  | insert a s ha ih =>
    rw [Finset.set_biInter_insert]
    exact (ht a (Finset.mem_insert_self a s)).inter
      (ih fun i hi => ht i (Finset.mem_insert_of_mem hi))

theorem iUnion_finset {ι : Type*} (s : Finset ι) {t : ι → Set X}
    (ht : ∀ i ∈ s, Semialg R (t i)) : Semialg R (⋃ i ∈ s, t i) := by
  classical
  induction s using Finset.induction_on with
  | empty => exact empty.of_eq (by simp)
  | insert a s ha ih =>
    rw [Finset.set_biUnion_insert]
    exact (ht a (Finset.mem_insert_self a s)).union
      (ih fun i hi => ht i (Finset.mem_insert_of_mem hi))

theorem iInter {ι : Type*} [Fintype ι] {t : ι → Set X} (ht : ∀ i, Semialg R (t i)) :
    Semialg R (⋂ i, t i) := by
  have := iInter_finset (R := R) Finset.univ fun i _ => ht i
  simpa using this

theorem iUnion {ι : Type*} [Fintype ι] {t : ι → Set X} (ht : ∀ i, Semialg R (t i)) :
    Semialg R (⋃ i, t i) := by
  have := iUnion_finset (R := R) Finset.univ fun i _ => ht i
  simpa using this

/-- A set defined by a finite case analysis on finitely many data: the union over all values
`a : α` of the realization sets. -/
theorem iUnion_setOf {α : Type*} [Fintype α] {φ : X → α} {p : α → Prop}
    (hφ : ∀ a, Semialg R {x | φ x = a}) : Semialg R {x | p (φ x)} := by
  classical
  have : {x | p (φ x)} = ⋃ a ∈ (Finset.univ.filter p), {x | φ x = a} := by
    ext x
    simp
  rw [this]
  exact iUnion_finset _ fun a _ => hφ a

/-- Membership of a finite-type-valued datum in a set. -/
theorem setOf_mem {α : Type*} [Fintype α] {φ : X → α} (A : Set α)
    (hφ : ∀ a, Semialg R {x | φ x = a}) : Semialg R {x | φ x ∈ A} :=
  iUnion_setOf (p := fun a => a ∈ A) hφ

theorem mono {R R' : Subring (X → ℝ)} (h : R ≤ R') {s : Set X} (hs : Semialg R s) :
    Semialg R' s := by
  induction hs with
  | pos hr => exact pos (h hr)
  | univ => exact univ
  | compl _ ih => exact ih.compl
  | inter _ _ ih₁ ih₂ => exact ih₁.inter ih₂

/-- Preimages along a map `f : Y → X` that pulls `R` back into `R'`. -/
theorem preimage {Y : Type*} {R' : Subring (Y → ℝ)} (f : Y → X)
    (hf : ∀ r ∈ R, (fun y => r (f y)) ∈ R') {s : Set X} (hs : Semialg R s) :
    Semialg R' (f ⁻¹' s) := by
  induction hs with
  | pos hr => exact pos (hf _ hr)
  | univ => exact univ
  | compl _ ih => exact ih.compl
  | inter _ _ ih₁ ih₂ => exact ih₁.inter ih₂

end Semialg

end TS
